#!/usr/bin/env bash
set -euo pipefail

# The installer puts a symlink on PATH. Find the clone before dispatching.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

case "${1:-restart}" in
  restart|start)
    exec "$SCRIPT_DIR/restart.sh"
    ;;
  stop|kill)
    exec "$SCRIPT_DIR/kill.sh"
    ;;
  settings)
    exec "$SCRIPT_DIR/open-settings.sh"
    ;;
  *)
    echo "Usage: taskbar [restart|start|stop|kill|settings]" >&2
    exit 2
    ;;
esac
